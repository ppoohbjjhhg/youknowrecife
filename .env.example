# Usada apenas pela função serverless em api/claude.js — nunca é
# enviada ao navegador. Em produção (Vercel), configure isto nas
# variáveis de ambiente do projeto, não em um arquivo .env commitado.
ANTHROPIC_API_KEY=sk-ant-...

# Alternativa gratuita à Anthropic, também usada só no servidor
# (api/claude.js). Gere em aistudio.google.com/apikey.
GEMINI_API_KEY=AIza...

# Configuração do Firebase (Autenticação + Firestore). Estes valores NÃO
# são secretos — ficam expostos no navegador por design do Firebase; quem
# protege os dados são as Regras de Segurança configuradas no console.
# Prefixo VITE_ é obrigatório para o Vite expor a variável ao front-end.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
